# Google OAuth client (Google Cloud Console → Credentials → OAuth client ID, type "Web application")
# Authorized redirect URI must be ${PUBLIC_BASE_URL}/oauth/google/callback
GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_client_secret

# Public origin of this server (https in production). The MCP endpoint is ${PUBLIC_BASE_URL}/mcp
PUBLIC_BASE_URL=http://localhost:8000

# Comma-separated Google accounts allowed to connect
ALLOWED_EMAILS=you@gmail.com

# Optional
# DATA_DIR=./data           # where store.json (OAuth state) is kept
# PORT=8000
# TRUST_PROXY=1             # proxy hops in front of the server (CapRover nginx = 1)
# GOOGLE_SCOPES="openid email https://www.googleapis.com/auth/googlehealth...."  # override requested scopes
# MCP_ACCESS_TOKEN_TTL_SECONDS=3600
# MCP_REFRESH_TOKEN_TTL_SECONDS=7776000
